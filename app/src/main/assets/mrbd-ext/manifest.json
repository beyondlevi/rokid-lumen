{
  "manifest_version": 2,
  "name": "MRBD host",
  "version": "1.7",
  "browser_specific_settings": { "gecko": { "id": "mrbd-host@lumen.dev" } },
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons", "proxy", "<all_urls>"],
  "background": { "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start", "all_frames": false }
  ]
}
